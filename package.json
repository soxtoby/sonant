{
  "name": "sonant",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soxtoby/sonant.git"
  },
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sinks/console": {
      "types": "./dist/sinks/console.d.ts",
      "import": "./dist/sinks/console.js"
    },
    "./sinks/seq": {
      "types": "./dist/sinks/seq.d.ts",
      "import": "./dist/sinks/seq.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun typecheck && bun test && bun run compile",
    "version": "bun scripts/version.ts"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "peerDependencies": {
    "seq-logging": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "seq-logging": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.5.0"
  }
}
